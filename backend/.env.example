# =============================================================================
# Gemstone Traceability System — Backend Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# ─── Ethereum (Identity Layer) ────────────────────────────────────────────────
# RPC endpoint — use Infura, Alchemy, or a local Hardhat node
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed IdentityRegistry contract address on the target network
ETH_CONTRACT_ADDRESS=0xYourIdentityRegistryContractAddress

# Private key of the backend signer wallet (no 0x prefix needed — ethers handles both)
ETH_PRIVATE_KEY=your_ethereum_private_key_here

# Chain ID (Sepolia=11155111, Mainnet=1, Hardhat local=31337)
ETH_CHAIN_ID=11155111

# ─── Aptos (Event Layer) ──────────────────────────────────────────────────────
# Aptos REST node URL
APTOS_NODE_URL=https://fullnode.devnet.aptoslabs.com/v1

# Aptos Faucet URL (devnet/testnet only — leave blank for mainnet)
APTOS_FAUCET_URL=https://faucet.devnet.aptoslabs.com

# Hex-encoded private key for the Aptos signer account (ed25519)
APTOS_PRIVATE_KEY=0xYourAptosPrivateKeyHere

# The on-chain module address where GemEvent.move is published
APTOS_MODULE_ADDRESS=0xYourAptosModuleAddressHere

# Network: devnet | testnet | mainnet
APTOS_NETWORK=devnet

# ─── Cardano (Certification Layer) ────────────────────────────────────────────
# Blockfrost project ID for the target network
BLOCKFROST_PROJECT_ID=previewYourBlockfrostProjectId

# Network: preview | preprod | mainnet
CARDANO_NETWORK=preview

# Bech32 address of the deployed certificate validator script
CARDANO_SCRIPT_ADDRESS=addr_test1yourScriptAddressHere

# Space-separated mnemonic words for the issuer hot wallet
CARDANO_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
